{
  "client": {
    "initial_pool_size": 10,
    "enable_logging": false
  },
  "logs_store": {
    "enabled": false
  },
  "config_store": 
  { "enabled": false 
  },
  "framework": {
    "pricing": {
      "live_models_sync_interval": 0,
      "mcp_library_sync_interval": 0
    }
  },
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini-primary",
          "value": "env.GEMINI_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    },
    "groq": {
      "keys": [
        {
          "name": "groq-primary",
          "value": "env.GROQ_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    }
  }
}