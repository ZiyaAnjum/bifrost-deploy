# Environment variables for Render or local docker-compose
# Never commit real secrets.

# Upstream provider API keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Virtual key used by TruthSync backend to authenticate against Bifrost
BIFROST_VK=sk-bf-your_virtual_key_here

# Bifrost runtime configuration
APP_PORT=8080
APP_HOST=0.0.0.0

